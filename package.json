{
	"name": "i-have-a-rock",
	"version": "0.1.0",
	"private": true,
	"description": "A plugin connecting Zotero and Obsidian.",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w @i-have-a-rock/obsidian",
		"build": "npm run build -w @i-have-a-rock/obsidian",
		"typecheck": "tsc -p packages/core --noEmit && tsc -p packages/obsidian --noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^4.1.12"
	}
}
